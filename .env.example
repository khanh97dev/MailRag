# Copy to .env and edit. Nothing secret belongs in this file once it is committed.

# Bearer token the retrieval API requires. Dify sends it from the HTTP node's
# authorization config, or from the External Knowledge API entry.
MAILRAG_API_KEY=mailrag-demo-key

# The knowledge_id this service answers for; any other id gets Dify error 2001.
MAILRAG_KNOWLEDGE_ID=emails

# Host port, for curl-ing the API yourself. Dify does not use it -- it reaches the
# container over the shared docker network as http://mailrag:8000.
MAILRAG_PORT=8100

# Mail to index. Point it at your own maildir to demo on real mail:
#   MAILRAG_MAIL_SOURCE=/var/mail/archive/example.com
MAILRAG_MAIL_SOURCE=./samples

# Name of the docker network Dify runs on. Dify's compose lives in dify/docker,
# so its default network is docker_default.
DIFY_NETWORK=docker_default

# The Groq API key does NOT go here. It belongs in Dify:
# Settings -> Model Provider -> Groq. Dify holds it; this service never sees it.
